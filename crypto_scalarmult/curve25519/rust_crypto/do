#!/usr/bin/env bash
# Build the Rust library and create the necessary files for SUPERCOP

# Use LLVM 19 tools to match Rust's LLVM version
export AR=/usr/bin/llvm-ar-19
export RANLIB=/usr/bin/llvm-ranlib-19
export NM=/usr/bin/llvm-nm-19

# Set the BFD plugin path to use LLVM 19
export BFD_PLUGINS=/usr/lib/llvm-19/lib/LLVMgold.so

# Build the Rust library in release mode without LTO to avoid plugin issues
RUSTFLAGS="-C lto=no -C embed-bitcode=no -C opt-level=3 -C target-cpu=native -C linker-plugin-lto=no" cargo build --release

# Create a single combined object file for SUPERCOP
# First compile our C wrapper to object
gcc -c -O3 -fPIC scalarmult.c -o scalarmult_wrapper.o

# Create a simple archive with both the Rust library and C wrapper
/usr/bin/llvm-ar-19 rcs scalarmult.a scalarmult_wrapper.o target/release/libcrypto_scalarmult_curve25519.a

# Extract all objects into a single .o file that SUPERCOP expects
/usr/bin/llvm-ar-19 x scalarmult.a
mv crypto_scalarmult_curve25519*.o scalarmult.o 2>/dev/null || true

# If that didn't work, try a different approach
if [ ! -f scalarmult.o ]; then
    # Just use the wrapper as the main object
    cp scalarmult_wrapper.o scalarmult.o
    # And create the header file that might be needed
    echo "extern int crypto_scalarmult(unsigned char *q, const unsigned char *n, const unsigned char *p);" > crypto_scalarmult.h
    echo "extern int crypto_scalarmult_base(unsigned char *q, const unsigned char *n);" >> crypto_scalarmult.h
fi

# Clean up
rm -f scalarmult.a scalarmult_wrapper.o

# Keep files in place for now

echo "Rust crypto library built successfully"