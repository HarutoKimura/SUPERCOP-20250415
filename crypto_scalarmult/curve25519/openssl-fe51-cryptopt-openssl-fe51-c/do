#!/usr/bin/env bash
# create cryptopt-asms
sfile="$(dirname "${0}")/asm.S"
test -e "${sfile}" && rm "${sfile}"
count=${1:-1}

resdir=${RESULTS_PATH:-~/cryptopt/results}

# Direct paths to openssl-fe51-c assembly files
mul_asm="${resdir}/openssl-fe51-c/mul/seed0001751441780944_ratio11932.asm"
square_asm="${resdir}/openssl-fe51-c/square/seed0001751442665031_ratio11816.asm"

# Convert and append mul - need to rename function to match fiat naming
if [ -f "${mul_asm}" ]; then
  ~/cryptopt/modules/scripts/convert/intel2att.sh --crypto-namespace "${mul_asm}" | \
    sed 's/open_ssl_curve25519_fe51_mul_CryptOpt/fiat_curve25519_carry_mul/g' >>"${sfile}"
else
  echo "Could not find mul assembly: ${mul_asm}"
  exit 1
fi

# Convert and append square - need to rename function to match fiat naming
if [ -f "${square_asm}" ]; then
  ~/cryptopt/modules/scripts/convert/intel2att.sh --crypto-namespace "${square_asm}" | \
    sed 's/open_ssl_curve25519_fe51_square_CryptOpt/fiat_curve25519_carry_square/g' >>"${sfile}"
else
  echo "Could not find square assembly: ${square_asm}"
  exit 1
fi
